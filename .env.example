# ==========================================
# Celesto AI Agent Hackathon Environment Config
# ==========================================

# Control Plane Service
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
# When running locally without docker compose, default to postgresql+asyncpg://postgres:postgres@localhost:5432/celesto_ledger
# When running inside docker compose: postgresql+asyncpg://postgres:postgres@ledger:5432/celesto_ledger
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/celesto_ledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=celesto_ledger
POSTGRES_PORT=5432

# ==========================================
# Celesto Cloud Credentials (Required for Live Execution)
# ==========================================
# 1. Sign up / Log in at https://celesto.ai
# 2. Go to Dashboard -> Settings -> Security / API Keys
# 3. Create a key with 'Create, start, stop computers and run commands' permission enabled
# 4. Under Billing / Usage, click 'Start the free $5 trial' or add prepaid credits
# 5. Paste the key here (format: cel_...)
CELESTO_API_KEY=your_celesto_api_key_here

# Optional: Celesto API base URL (defaults to production)
CELESTO_BASE_URL=https://api.celesto.ai/v1

# ==========================================
# LLM Provider Configuration (OpenAI-compatible)
# ==========================================
# Supports OpenAI, Google Gemini (via OpenAI-compatible endpoint), Groq, OpenRouter, Ollama, etc.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o

# ==========================================
# Sandbox Runtime Defaults
# ==========================================
DEFAULT_SANDBOX_TEMPLATE=coding-agent
DEFAULT_SANDBOX_CPUS=1
DEFAULT_SANDBOX_MEMORY_MB=1024
DEFAULT_SANDBOX_DISK_MB=15360
SANDBOX_TIMEOUT_SECONDS=600

# Safety & Policy Configuration
AUDIT_LOG_PATH=logs/commands.jsonl
BLOCKED_COMMAND_PATTERNS="rm -rf /|:(){ :|:& };:|mkfs|dd if=|curl.*http://.*exfil|wget.*http://.*exfil"
ALLOWED_COMMAND_PREFIXES="git,python,pytest,pytest-3,pip,ls,dir,cat,echo,mkdir,touch,cp,mv,grep,find,pwd,which,uname,whoami,head,tail,diff"
